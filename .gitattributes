# Repository speichert immer LF. Was im Arbeitsverzeichnis landet, entscheidet
# core.autocrlf der jeweiligen Maschine (Windows: CRLF, Linux/macOS: LF).
* text=auto

# Shell-Skripte muessen plattformunabhaengig LF behalten, sonst scheitern sie
# mit "bad interpreter: /bin/sh^M".
*.sh   text eol=lf
mvnw   text eol=lf

# Windows-Skripte brauchen umgekehrt immer CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binaerdateien nie konvertieren.
*.jar  binary
*.png  binary
*.pdf  binary
*.db   binary